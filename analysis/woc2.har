            "mimeType": "text/html",
            "size": 688,
            "text": "<!DOCTYPE html>\n<html lang=\"en\">\n\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>World</title>\n\n    <script type=\"module\" src=\"../js/world.js\" defer></script>\n    <script src=\"../js/sweetalert2.js\" defer></script>\n    \n    <link rel=\"stylesheet\" href=\"css/sweetalert2.css\">\n\n</head>\n\n<body id=\"doc_body\" style=\"position: relative;\">\n\n    <header id=\"status_bar\" style=\"display: flex; flex-direction: row\">\n        <p id=\"world_info_txt\"></p>\n    </header>\n    \n    <main id=\"space\">\n        <div id=\"game_grid\" style=\"display: flex; flex-direction: column\">\n            \n        </div>\n    </main>\n\n</body>\n\n</html>"
